{
  "name": "@bitrouter/opencode",
  "version": "0.1.0",
  "description": "BitRouter provider plugin for opencode — dynamic model discovery, brvk_ keys, and BitRouter Cloud device login",
  "type": "module",
  "license": "Apache-2.0",
  "author": "BitRouterAI",
  "homepage": "https://github.com/bitrouter/bitrouter-opencode#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bitrouter/bitrouter-opencode.git"
  },
  "bugs": {
    "url": "https://github.com/bitrouter/bitrouter-opencode/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "bitrouter",
    "llm",
    "ai-gateway",
    "provider"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build",
    "schema:refresh": "node scripts/refresh-schema.mjs",
    "schema:check": "node scripts/refresh-schema.mjs --check"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.18.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.21",
    "@opencode-ai/sdk": "^1.18.25",
    "@types/node": "^26.2.0",
    "ajv": "^8.20.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
